<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="publish_year"/>
            </list>
        </field>
    </record>
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="isbn"/>
                        <field name="publish_year"/>
                    </group>
                    <notebook>
                        <page string="Copies">
                            <field name="copy_ids">
                                <list editable="bottom">
                                    <field name="inventory_number"/>
                                    <field name="condition"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_library_copy_list" model="ir.ui.view">
        <field name="name">library.copy.list</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <list string="Copies">
                <field name="inventory_number"/>
                <field name="book_id"/>
                <field name="condition"/>
            </list>
        </field>
    </record>
    <record id="view_library_copy_form" model="ir.ui.view">
        <field name="name">library.copy.form</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <form string="Copy">
                <sheet>
                    <group>
                        <field name="inventory_number"/>
                        <field name="book_id"/>
                        <field name="condition"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_library_copy" model="ir.actions.act_window">
        <field name="name">Copies</field>
        <field name="res_model">library.copy</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_library_member_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="name"/>
                <field name="membership_number"/>
            </list>
        </field>
    </record>
    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="membership_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_library_loan_list" model="ir.ui.view">
        <field name="name">library.loan.list</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <list string="Loans">
                <field name="copy_id"/>
                <field name="book_author"/>
                <field name="member_id"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form string="Loan">
                <sheet>
                    <group>
                        <field name="copy_id"/>
                        <field name="book_author"/>
                        <field name="member_id"/>
                        <field name="loan_date"/>
                        <field name="due_date"/>
                        <field name="return_date"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_root" name="Library Rental" sequence="50"/>
    <menuitem id="menu_library_books" name="Books" parent="menu_library_root"
              action="action_library_book" sequence="10"/>
    <menuitem id="menu_library_copies" name="Copies" parent="menu_library_root"
              action="action_library_copy" sequence="20"/>
    <menuitem id="menu_library_members" name="Members" parent="menu_library_root"
              action="action_library_member" sequence="30"/>
    <menuitem id="menu_library_loans" name="Loans" parent="menu_library_root"
              action="action_library_loan" sequence="40"/>
</odoo>
