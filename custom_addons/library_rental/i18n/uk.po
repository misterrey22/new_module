#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid "Invalid date"
msgstr "Некоректна дата"

#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid ""
"The loan date cannot be in the future. Choose today or an earlier date."
msgstr ""
"Дата видачі не може бути в майбутньому. Виберіть сьогоднішню або минулу дату."

#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid ""
"The return date cannot be in the future. Choose today or an earlier date."
msgstr ""
"Дата фактичного повернення не може бути в майбутньому. Виберіть сьогоднішню "
"або минулу дату."

#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid "A copy cannot have more than one active or overdue loan."
msgstr "Примірник не може мати більше однієї активної або простроченої видачі."

#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid "A loan with a return date must have the Returned status."
msgstr "Видача із заповненою датою повернення має статус «Повернена»."

#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid "The due date must be later than the loan date."
msgstr "Термін повернення має бути пізніше за дату видачі."

#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid "The return date cannot be earlier than the loan date."
msgstr "Дата фактичного повернення не може бути раніше дати видачі."

#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid "The status must match the loan dates and return date."
msgstr "Статус має відповідати датам видачі та фактичного повернення."

#. module: library_rental
#. odoo-python
#: code:addons/library_rental/models/loan.py:0
msgid "The loan status is automatic and cannot be changed manually."
msgstr "Статус видачі встановлюється автоматично та не може змінюватися вручну."
